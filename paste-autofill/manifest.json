{
  "manifest_version": 3,
  "name": "Auto full",
  "version": "1.1.1",
  "minimum_chrome_version": "123",
  "description": "Fill saved profile details as you click or Tab through application forms.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Auto full — edit profile",
    "default_icon": {
      "16": "icons/auto-full-16.png",
      "32": "icons/auto-full-32.png"
    }
  },
  "icons": {
    "16": "icons/auto-full-16.png",
    "32": "icons/auto-full-32.png",
    "48": "icons/auto-full-48.png",
    "128": "icons/auto-full-128.png"
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "profile.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["matching.js", "content.js"]
    }
  ]
}
